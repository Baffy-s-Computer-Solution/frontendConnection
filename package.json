{
  "name": "career-connect-lesotho-frontend",
  "version": "2.0.0",
  "description": "Career Connect Lesotho - Frontend Application for connecting job seekers with employers in Lesotho",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Career Connect Lesotho Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/career-connect-lesotho-frontend.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest watch --coverage",
    "test:unit": "vitest run --dir src/test/unit",
    "test:unit:watch": "vitest watch --dir src/test/unit",
    "test:integration": "vitest run --dir src/test/integration",
    "test:integration:watch": "vitest watch --dir src/test/integration",
    "test:components": "vitest run --dir src/test/unit/components",
    "test:hooks": "vitest run --dir src/test/unit/hooks",
    "test:services": "vitest run --dir src/test/unit/services",
    "test:utils": "vitest run --dir src/test/unit/utils",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:silent": "vitest run --silent",
    "test:verbose": "vitest run --reporter=verbose",
    "test:json": "vitest run --reporter=json --outputFile=./coverage/test-results.json",
    "test:junit": "vitest run --reporter=junit --outputFile=./coverage/junit.xml",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=./coverage/junit.xml --reporter=verbose",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --pool=forks --poolOptions.forks.singleFork=true",
    "test:profile": "vitest run --reporter=verbose --logHeapUsage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "test:e2e:install": "playwright install --with-deps",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:all:ci": "npm run test:ci && npm run test:e2e",
    "test:full": "npm run lint && npm run type-check && npm run test:coverage && npm run test:e2e",
    "test:smoke": "vitest run --dir src/test/smoke",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "clean": "rimraf dist node_modules/.vite .eslintcache coverage test-results playwright-report",
    "clean:all": "rimraf dist node_modules .eslintcache package-lock.json coverage test-results playwright-report",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "commit": "git-cz",
    "release": "standard-version",
    "analyze": "rollup-plugin-visualizer",
    "plop": "plop",
    "fix-all": "npm run clean && npm install && npm run lint:fix && npm run format && npm run type-check"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@popperjs/core": "^2.11.8",
    "@react-aria/focus": "^3.21.3",
    "@react-aria/utils": "^3.21.3",
    "@restart/ui": "^1.6.9",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.52.2",
    "aos": "^2.3.4",
    "axios": "^1.6.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "emoji-picker-react": "^4.17.1",
    "firebase": "^10.14.0",
    "formik": "^2.4.6",
