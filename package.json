    "plop": "^4.0.1",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.77.8",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.3",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
